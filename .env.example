# All settings are optional for topic discovery and local publishing rehearsals.
# Copy to .env if you prefer configuring the application through the environment.
PORT=4317
OPEN_SOCIAL_DATA_DIR=.data

# Discovery (HN and GitHub work without credentials)
GITHUB_TOKEN=
ENABLE_BLUESKY_SEARCH=false
X_BEARER_TOKEN=

# X publishing (OAuth app, or an existing user access token)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_ACCESS_TOKEN=

# LinkedIn personal publishing (OAuth app, or a user access token + author URN)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_NATIVE_PKCE=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202609

# Optional self-hosted xiaohongshu-mcp bridge (see docs/xiaohongshu.md)
XHS_BRIDGE_URL=
XHS_BRIDGE_TOKEN=
XHS_LOCAL_MEDIA_DIR=
XHS_BRIDGE_MEDIA_DIR=
